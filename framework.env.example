# Copy to framework.env. Do not commit framework.env.
# The Flutter project root, relative to this kit. Use . when the kit is installed
# at the application's root.
APP_ROOT=.
RELEASES_DIR=releases

# Required for device reset and Google Play upload. Do not put a real app ID in
# this example repository.
ANDROID_PACKAGE_NAME=com.example.app

# Optional overrides
INTEGRATION_TEST_DIR=integration_test
PLAY_TRACK=internal
PLAY_ACCOUNT_FILE=secrets/play-account.json
